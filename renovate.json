{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitsDisabled"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Base images"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch"
    },
    {
      "description": "compose.yaml follows the app's own :latest tag on purpose; a pinned digest would freeze installs on one release.",
      "matchPackageNames": [
        "ghcr.io/noahtrr/ev-dashboard"
      ],
      "enabled": false
    },
    {
      "description": "TypeScript 7 has no JavaScript API yet, which svelte-kit sync and svelte-check need. Lift once they support it.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
