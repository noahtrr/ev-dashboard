# EV Dashboard configuration. Copy to .env and fill in.
# Full reference: https://github.com/noahtrr/ev-dashboard/wiki

# --- General ---
# Public URL of your instance (used for links and OAuth redirects)
APP_URL=https://ev.example.com
# Database and generated secrets live here. Set by the image (/data); only change it
# when running the app outside Docker.
# DATA_DIR=/data

# --- TLS / reverse proxy ---
# auto     = Caddy gets a Let's Encrypt certificate (ports 80/443 must reach the container)
# internal = self-signed certificate (local testing)
# off      = plain HTTP on port 8080, for running behind your own reverse proxy
TLS_MODE=auto
# Contact address for Let's Encrypt (required when TLS_MODE=auto)
ACME_EMAIL=
# Proxies whose X-Forwarded-* headers are trusted (TLS_MODE=off)
TRUSTED_PROXIES=private_ranges

# --- Authentication ---
# Callback URLs to register at the providers (replace <APP_URL> with your APP_URL):
#   GitHub: <APP_URL>/api/auth/callback/github
#   Google: <APP_URL>/api/auth/callback/google
#   OIDC:   <APP_URL>/api/auth/callback/oidc
# The first account becomes admin (open <APP_URL>/setup on first start).

# Session signing secret, at least 32 characters (openssl rand -base64 32).
# Leave empty to generate one on first start; it is kept in /data/auth-secret.
AUTH_SECRET=
# Key for encrypting the vehicle API credentials each user enters on the account page,
# at least 32 characters. Leave empty to generate one in /data/encryption-key.
# Changing it later makes stored credentials unreadable (users have to enter them again).
ENCRYPTION_KEY=
# Sign-in methods (true/false)
AUTH_EMAIL_PASSWORD=true
AUTH_PASSKEY=true
# Allow new registrations after the first account (also first-time social/SSO sign-ins)
AUTH_ALLOW_SIGNUP=false

# Sign in with GitHub (enabled when both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Google (enabled when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Single sign-on via OpenID Connect, e.g. Authentik, Keycloak, Entra ID
# (enabled when issuer, client ID and secret are set)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label
OIDC_NAME=SSO

# --- Vehicle data ---
# Each user enters their own vehicle API credentials on the account page and registers
# <APP_URL>/api/providers/connect-query/callback as redirect URI in their developer app.
# Seconds between two fetches per connected vehicle (minimum 60). Polling too often can
# get the vehicle account locked at the provider; keep the default unless you need more.
POLL_INTERVAL_SECONDS=300
# Days to keep fetched vehicle data; older snapshots are deleted once a day. 0 = forever.
RETENTION_DAYS=365

# --- Address ---
# The server sends the vehicle position to this Nominatim-compatible service to show the
# street address (cached, at most one request per second). Set to false to keep the
# position on the server.
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org

# --- Map ---
# The browser loads map tiles directly from this server, so it learns which area is shown.
# Defaults to OpenFreeMap (free, no key). Any vector tiles in the OpenMapTiles schema work.
MAP_TILES_URL=https://tiles.openfreemap.org/planet
MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
